// KSFH Meals — Prisma schema
// All application state lives in Supabase Postgres. No filesystem persistence.

generator client {
  provider = "prisma-client-js"
  // Vercel functions run on Amazon Linux 2023 (RHEL-based). Without the
  // rhel-openssl-3.0.x target the Prisma query engine binary won't be
  // bundled with the function and every request errors at runtime.
  // "native" keeps local dev working on macOS.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (port 6543) used at runtime. Required for serverless on Vercel.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) used by `prisma migrate` only.
  directUrl = env("DIRECT_URL")
}

enum HouseStatus {
  NewMember
  InHouse
  OutOfHouse
  Alumni
}

// One row per fraternity member. `id` is the user-entered identifier (e.g. "1855")
// and is the primary key — typed as String so it can hold non-numeric IDs cleanly.
model Member {
  id          String      @id
  firstName   String
  lastName    String
  // Denormalized "First Last" — kept in sync by server actions on every write.
  // Used for case/whitespace-insensitive lookup on /find-id.
  fullName    String
  houseStatus HouseStatus
  lunchesOwed Int         @default(0)
  dinnersOwed Int         @default(0)

  // 12-slot meal plan. Indexes:
  //   0=MonLunch  1=MonDinner  2=TueLunch  3=TueDinner
  //   4=WedLunch  5=WedDinner  6=ThuLunch  7=ThuDinner
  //   8=FriLunch  9=FriDinner  10=SatLunch 11=SunLunch
  // Values: 0=In, 1=Out, 2=Early, 3=Late.
  weeklyPlan  Int[]
  defaultPlan Int[]

  // Healthy (chicken) option — swaps the main dish for chicken at a meal the
  // member is still attending. Eligible meals are Mon/Tue/Thu dinner (slots
  // 1, 3, 7), so 3 is the weekly max. See HEALTHY_SLOTS in app/_lib/meals.ts.
  //
  // healthySlots holds slot INDEXES (e.g. [3, 7]), not a parallel 12-length
  // array. That keeps no array length load-bearing here — see the note in
  // README.md about padding the fixed-length plan arrays.
  healthyQuota        Int   @default(0)  // swaps allowed this week (0–3)
  // UNUSED since the count became weekly-reset and This-Week-only. Kept
  // rather than dropped so a live migration isn't needed; safe to remove.
  defaultHealthyQuota Int   @default(0)
  healthySlots        Int[] @default([]) // slots spent so far this week
  // Which chicken-week the two fields above belong to, as the date of that
  // week's Saturday ("2026-08-22"). The count resets to 0 every Saturday
  // 00:00; rather than run a scheduled job, anything tagged with an older
  // week simply reads as 0. See chickenWeekOf() in app/_lib/meals.ts.
  healthyWeekOf       String?

  // Free-text allergies / dietary restrictions, entered by the member on
  // /default-plan. Null or empty means nothing to report. Shown at the top of
  // the (public) /plates page so the kitchen always sees it, not just on the
  // days that member eats.
  allergens String?

  @@index([fullName])
  @@index([houseStatus])
}

// Singleton table — always exactly one row with id = 1.
// Seed inserts it if absent; admin form upserts it.
model Menu {
  id     Int      @id @default(1)
  // 7 entries Mon..Sun
  lunch  String[]
  // 5 entries Mon..Fri (no Sat/Sun dinner)
  dinner String[]
}
